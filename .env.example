# Server-only download configuration (set in Vercel / .env.local — never commit real values)
# Copy to .env.local for local development, then restart `npm run dev`.

# Registry: id, link (full MSI URL), authorized domains — editable only in Vercel admin env
# DOWNLOAD_REGISTRY={"products":[{"id":"revit-sheets","link":"https://files.digibimhub.com/installers/test.msi","domains":["acme.com","digibimhub.com"]}]}

# Contact form (Resend) — set in Vercel / .env.local
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=info@digibimhub.com
# CONTACT_FROM_EMAIL=info@digibimhub.com
